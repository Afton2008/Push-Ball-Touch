GROWTH_LEVELS = 24

def width_scale(idx):
    if idx >= GROWTH_LEVELS - 1:
        return 1.0
    t = idx / (GROWTH_LEVELS - 1)
    base   = 0.40 + 0.60 * t
    wobble = 0.05 * math.sin(t * math.pi * 2.3)
    return max(0.38, min(1.0, base + wobble))

def height_scale(idx):

    if idx >= GROWTH_LEVELS - 1:
        return 1.0
    t = idx / (GROWTH_LEVELS - 1)
    base   = 0.82 + 0.18 * (t ** 0.6)
    wobble = 0.03 * math.sin(t * math.pi * 1.7 + 1.1)
    return max(0.80, min(1.0, base + wobble))

def _scale_point(x, y, cx, cy, sx, sy):
    return (cx + (x - cx) * sx, cy + (y - cy) * sy)

def _place_rect_clip(r, cx, cy, sx, sy, arena):
    nx, ny = _scale_point(r.x, r.y, cx, cy, sx, sy)
    nr = pygame.Rect(round(nx), round(ny), r.w, r.h)
    return nr.clip(arena)

def _place_rect_clamp(r, cx, cy, sx, sy, arena):
    nx, ny = _scale_point(r.x, r.y, cx, cy, sx, sy)
    nr = pygame.Rect(round(nx), round(ny), r.w, r.h)
    if nr.w >= arena.w or nr.h >= arena.h:
        return nr.clip(arena)
    if nr.left   < arena.left:   nr.x = arena.left
    if nr.top    < arena.top:    nr.y = arena.top
    if nr.right  > arena.right:  nr.x = arena.right  - nr.w
    if nr.bottom > arena.bottom: nr.y = arena.bottom - nr.h
    return nr

def _place_point(x, y, w, h, cx, cy, sx, sy, arena, anchor="topleft"):
    r = pygame.Rect(0, 0, w, h)
    if anchor == "center":
        r.center = (x, y)
    else:
        r.x, r.y = x, y
    pr = _place_rect_clamp(r, cx, cy, sx, sy, arena)
    return pr.center if anchor == "center" else (pr.x, pr.y)

def build_scaled_level(raw, sx, sy, arena):
    cx, cy = REF_ARENA.centerx, REF_ARENA.centery
    d = {"name": raw["name"], "info": raw["info"], "friction": raw["friction"]}

    d["player_start"] = _place_point(*raw["player_start"], PLAYER_SIZE, PLAYER_SIZE, cx, cy, sx, sy, arena)
    d["ball_start"]   = _place_point(*raw["ball_start"], BALL_RADIUS*2, BALL_RADIUS*2, cx, cy, sx, sy, arena, anchor="center")
    d["goal_pos"]     = _place_point(*raw["goal_pos"], GOAL_W, GOAL_H, cx, cy, sx, sy, arena)

    d["walls"] = [_place_rect_clip(w, cx, cy, sx, sy, arena) for w in raw["walls"]]
    d["holes"] = [_place_rect_clamp(h, cx, cy, sx, sy, arena) for h in raw["holes"]]
    d["magnet_zones"] = [
        {"rect": _place_rect_clamp(mz["rect"], cx, cy, sx, sy, arena), "force": mz["force"]}
        for mz in raw["magnet_zones"]
    ]
    d["winds"] = [dict(w) for w in raw["winds"]]
    d["keys"] = []
    for k in raw["keys"]:
        _kr = _place_rect_clamp(k["rect"], cx, cy, sx, sy, arena)
        d["keys"].append({
            "rect": _kr, "collected": False,
            "vx": 0.0, "vy": 0.0, "portal_cd": 0,
            "start_x": _kr.x, "start_y": _kr.y,
        })

    d["gates"] = []
    for g in raw["gates"]:
        r = _place_rect_clip(g["rect"], cx, cy, sx, sy, arena)
        ng = {"type": g["type"], "open": False, "rect": r, "x": r.x, "y": r.y}
        if g["type"] == "V":
            ng["thickness"], ng["length"] = r.w, r.h
        else:
            ng["thickness"], ng["length"] = r.h, r.w
        d["gates"].append(ng)

    d["buttons"] = [
        {"rect": _place_rect_clamp(b["rect"], cx, cy, sx, sy, arena), "gate_index": b["gate_index"], "active": False}
        for b in raw["buttons"]
    ]

    d["portals"] = []
    for p in raw["portals"]:
        d["portals"].append({
            "a": _place_rect_clamp(p["a"], cx, cy, sx, sy, arena), "b": _place_rect_clamp(p["b"], cx, cy, sx, sy, arena),
            "va": [p["va"][0] * sx, p["va"][1] * sy], "vb": [p["vb"][0] * sx, p["vb"][1] * sy],
            "cooldown": 0, "player_cooldown": 0, "key_cd": 0,
        })
    return d

def eval_can_finish(d):
    global can_finish
    has_keys  = keys_total > 0
    has_gates = gates_total > 0
    if not has_keys and not has_gates:
        can_finish = True
    elif has_keys and not has_gates:

        can_finish = (keys_delivered >= keys_total)
    elif has_gates and not has_keys:

        can_finish = (gates_opened >= gates_total)
    else:

        can_finish = (gates_opened >= gates_total) and (keys_delivered >= keys_total)

