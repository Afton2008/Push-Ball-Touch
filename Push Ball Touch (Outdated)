def spawn_wind_particle(wind):
    Xa,Ya,W2a,Ha = ARENA.x,ARENA.y,ARENA.w,ARENA.h
    x = Xa+random.randint(0,W2a//3)     if wind["dx"]>0 else \
        Xa+random.randint(W2a*2//3,W2a) if wind["dx"]<0 else \
        Xa+random.randint(0,W2a)
    y = Ya+random.randint(0,Ha//3)      if wind["dy"]>0 else \
        Ya+random.randint(Ha*2//3,Ha)   if wind["dy"]<0 else \
        Ya+random.randint(0,Ha)
    sp = random.uniform(2.5,5.0)
    hue = int((math.atan2(wind["dy"],wind["dx"])+math.pi)/(2*math.pi)*6)
    cols = [(180,220,255),(180,255,200),(255,220,160),(255,180,180),(220,180,255),(160,220,255)]
    wind_particles.append({
        "x":float(x),"y":float(y),
        "vx":wind["dx"]*sp,"vy":wind["dy"]*sp,
        "life":random.randint(35,75),"max_life":75,
        "length":random.randint(14,26),
        "bc":cols[hue%6]
    })

def update_draw_wind(wind):
    if random.random()<0.25: spawn_wind_particle(wind)

def flush_wind_particles():
    dead=[]
    for wp in wind_particles:
        wp["x"]+=wp["vx"]; wp["y"]+=wp["vy"]; wp["life"]-=1
        a=wp["life"]/wp["max_life"]
        bc=wp.get("bc",WIND_COLOR)
        col=(int(bc[0]*a),int(bc[1]*a),int(bc[2]*a))
        sl=max(abs(wp["vx"]),abs(wp["vy"]),1)
        ex=wp["x"]-wp["vx"]*(wp["length"]/sl)
        ey=wp["y"]-wp["vy"]*(wp["length"]/sl)
        pygame.draw.line(screen,col,(int(ex),int(ey)),(int(wp["x"]),int(wp["y"])),2)
        ang=math.atan2(wp["vy"],wp["vx"])
        for da in(2.4,-2.4):
            pygame.draw.line(screen,col,(int(wp["x"]),int(wp["y"])),
                (int(wp["x"]-8*math.cos(ang+da)),int(wp["y"]-8*math.sin(ang+da))),2)
        if wp["life"]<=0 or wp["x"]<ARENA.x or wp["x"]>ARENA.x+ARENA.w or \
           wp["y"]<ARENA.y or wp["y"]>ARENA.y+ARENA.h:
            dead.append(wp)
    for dd in dead: wind_particles.remove(dd)

def update_portals(d):
    for p in d["portals"]:
        pid = id(p)
        if pid not in portal_floats:
            portal_floats[pid] = {
                "ax":float(p["a"].x),"ay":float(p["a"].y),
                "bx":float(p["b"].x),"by":float(p["b"].y)
            }
        pf = portal_floats[pid]
        s  = p["a"].w

        for fk,vk,rk in [("ax","va","a"),("bx","vb","b")]:
            fx,fy = fk, fk.replace("x","y")
            vx,vy = p[vk][0], p[vk][1]

            pf[fx] += vx; pf[fy] += vy

            if pf[fx] < ARENA.left+2:
                pf[fx]=ARENA.left+2; p[vk][0]=abs(p[vk][0])
            if pf[fx]+s > ARENA.right-2:
                pf[fx]=ARENA.right-2-s; p[vk][0]=-abs(p[vk][0])
            if pf[fy] < ARENA.top+2:
                pf[fy]=ARENA.top+2; p[vk][1]=abs(p[vk][1])
            if pf[fy]+s > ARENA.bottom-2:
                pf[fy]=ARENA.bottom-2-s; p[vk][1]=-abs(p[vk][1])

            r_test = pygame.Rect(int(pf[fx]),int(pf[fy]),s,s)
            for w in d["walls"]:
                if r_test.colliderect(w):
                    p[vk][0]=-p[vk][0]; p[vk][1]=-p[vk][1]
                    pf[fx]-=vx*2; pf[fy]-=vy*2
                    break

            for g in d["gates"]:
                if not g["open"]:
                    r_test2=pygame.Rect(int(pf[fx]),int(pf[fy]),s,s)
                    if r_test2.colliderect(g["rect"]):
                        if g["type"]=="V": p[vk][0]=-p[vk][0]
                        else:              p[vk][1]=-p[vk][1]
                        pf[fx]-=vx; pf[fy]-=vy
                        break

            p[rk].x = int(pf[fx]); p[rk].y = int(pf[fy])

