def _boss_targets_for_category(d, cat):
    if cat=="magnet_zones": return [z["rect"].center for z in d["magnet_zones"]]
    if cat=="holes":        return [h.center for h in d["holes"]]
    if cat=="portals":      return [p["a"].center for p in d["portals"]] + [p["b"].center for p in d["portals"]]
    if cat=="keys":         return [k["rect"].center for k in d["keys"] if not k["collected"]]
    if cat=="gates":        return [g["rect"].center for g in d["gates"] if not g["open"]]
    if cat=="walls":        return [w.center for w in d["walls"]]
    if cat=="winds":        return [(ARENA.centerx,ARENA.centery)] if d["winds"] else []
    return []

def _boss_min_read_ticks(text):
    return max(BOSS_MIN_READ_TICKS, min(BOSS_MAX_READ_TICKS, int(len(text)*BOSS_READ_TICKS_PER_CHAR)+25))

