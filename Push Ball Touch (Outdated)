def render_text(font, text, color):
    k = (id(font), text, color)
    if k not in text_cache:
        text_cache[k] = font.render(text, True, color)
    return text_cache[k]

def clamp(val, mn, mx): return max(mn, min(mx, val))

def rect_circle_collide(rx,ry,rw,rh,cx,cy,cr):
    nx=clamp(cx,rx,rx+rw); ny=clamp(cy,ry,ry+rh)
    dx,dy=cx-nx,cy-ny
    return dx*dx+dy*dy<cr*cr

def resolve_rect_circle(rx,ry,rw,rh,cx,cy,cr):
    nx=clamp(cx,rx,rx+rw); ny=clamp(cy,ry,ry+rh)
    dx,dy=cx-nx,cy-ny
    dist=math.sqrt(dx*dx+dy*dy)
    if dist==0: return 0,-1,cr
    return dx/dist,dy/dist,cr-dist

def resolve_ball_against_blockers(ball_pos, ball_vel, blockers, passes=4):
    for _ in range(passes):
        hit_any=False
        for r in blockers:
            if rect_circle_collide(r.x,r.y,r.w,r.h,ball_pos[0],ball_pos[1],BALL_RADIUS):
                hit_any=True
                nx,ny,overlap=resolve_rect_circle(r.x,r.y,r.w,r.h,ball_pos[0],ball_pos[1],BALL_RADIUS)
                ball_pos[0]+=nx*(overlap+0.5); ball_pos[1]+=ny*(overlap+0.5)
                dot=ball_vel[0]*nx+ball_vel[1]*ny
                if dot<0:
                    ball_vel[0]=(ball_vel[0]-2*dot*nx)*BOUNCE
                    ball_vel[1]=(ball_vel[1]-2*dot*ny)*BOUNCE
        if not hit_any:
            break

def W(x,y,w,h):        return pygame.Rect(x,y,w,h)
def MZ(x,y,w,h,force): return {"rect":W(x,y,w,h),"force":force}
def HOLE(x,y,w=70,h=70): return W(x,y,w,h)
def WIND(dx,dy,st):    return {"dx":dx,"dy":dy,"strength":st}

def KEY(x,y): return {"rect":W(x,y,28,28),"collected":False,"orig_x":x,"orig_y":y}

def PORTAL(ax,ay,bx,by,s=44,vax=2.6,vay=1.3,vbx=-1.3,vby=2.6):
    return {
        "a":W(ax,ay,s,s), "b":W(bx,by,s,s),
        "va":[float(vax),float(vay)],
        "vb":[float(vbx),float(vby)],
        "cooldown":0,"player_cooldown":0
    }

