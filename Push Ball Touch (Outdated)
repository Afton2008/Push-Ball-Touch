def boss_tick(tick):
    if BOSS is None: return False
    ph=BOSS["phase"]
    if ph in ("intro","end"):
        BOSS["line_timer"]=BOSS.get("line_timer",0)+1
        return True
    if ph=="destroy":
        BOSS["timer"]+=1
        cat=BOSS["order"][BOSS["cat_i"]]
        pts=_boss_targets_for_category(CUR,cat)
        if BOSS["timer"]<BOSS_CHARGE_TICKS:
            BOSS["laser_on"]=True
            if pts:
                idxp=min(len(pts)-1,int(BOSS["timer"]/max(1,BOSS_CHARGE_TICKS)*len(pts)))
                BOSS["laser_target"]=pts[idxp]
        elif BOSS["timer"]==BOSS_CHARGE_TICKS:
            boss_clear_category(cat)
            BOSS["laser_on"]=False
        elif BOSS["timer"]>=BOSS_CHARGE_TICKS+BOSS_PAUSE_TICKS:
            BOSS["cat_i"]+=1; BOSS["timer"]=0
            if BOSS["cat_i"]>=len(BOSS["order"]):
                BOSS["phase"]="wait"
        return True
    if ph=="wait":
        return False
    if ph=="kill":
        BOSS["kill_timer"]+=1
        BOSS["laser_on"]=True
        BOSS["laser_target"]=(player.centerx,player.centery)
        if BOSS["kill_timer"]>=BOSS_KILL_TICKS:
            BOSS["phase"]="end"; BOSS["lines"]=BOSS_END_LINES; BOSS["end_i"]=0; BOSS["line_timer"]=0
            BOSS["laser_on"]=False
        return True
    return True

