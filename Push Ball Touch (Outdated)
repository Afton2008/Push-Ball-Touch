def draw_gates_and_buttons(d, tick):
    gates=d["gates"]; buttons=d["buttons"]

    for btn in buttons:
        gi=btn["gate_index"]
        if gi>=len(gates): continue
        g=gates[gi]
        bx,by=btn["rect"].centerx,btn["rect"].centery
        gx=g["x"]+g["thickness"]//2 if g["type"]=="V" else g["x"]+g["length"]//2
        gy=g["y"]+g["length"]//2    if g["type"]=="V" else g["y"]+g["thickness"]//2
        dx,dy=gx-bx,gy-by
        dist=math.sqrt(dx*dx+dy*dy) or 1
        steps=int(dist//12)
        for i in range(steps):
            t0=i/max(steps,1); t1=(i+0.6)/max(steps,1)
            x0=int(bx+dx*t0); y0=int(by+dy*t0)
            x1=int(bx+dx*t1); y1=int(by+dy*t1)
            if btn["active"]:
                phase=(tick*0.15-i*0.3)%(2*math.pi)
                bright=int(160+95*math.sin(phase))
                lc=(0,bright,int(bright*0.55))
            else:
                lc=(80,40,10)
            pygame.draw.line(screen,lc,(x0,y0),(x1,y1),2)

    for g in gates:
        r=g["rect"]
        if g["open"]:
            s=pygame.Surface((r.w,r.h),pygame.SRCALPHA)
            s.fill((0,200,80,20))
            screen.blit(s,(r.x,r.y))
            pygame.draw.rect(screen,(0,80,30),r,1)
        else:
            pulse=int(30+abs(math.sin(tick*0.06))*30)
            pygame.draw.rect(screen,(pulse*3,pulse,0),r)
            pygame.draw.rect(screen,GATE_CLOSED,r,3)
            if g["type"]=="V":
                for sy in range(r.y+4,r.y+r.h,20):
                    pygame.draw.line(screen,(160,60,0),(r.x,sy),(r.x+r.w,min(sy+14,r.y+r.h)),2)
            else:
                for sx in range(r.x+4,r.x+r.w,20):
                    pygame.draw.line(screen,(160,60,0),(sx,r.y),(min(sx+14,r.x+r.w),r.y+r.h),2)

    for btn in buttons:
        r=btn["rect"]
        col=BTN_ON if btn["active"] else BTN_OFF
        if not btn["active"]:
            pulse=int(18+abs(math.sin(tick*0.09))*18)
            gs=pygame.Surface((r.w+pulse*2,r.h+pulse*2),pygame.SRCALPHA)
            pygame.draw.ellipse(gs,(255,60,60,40),gs.get_rect())
            screen.blit(gs,(r.x-pulse,r.y-pulse))
        pygame.draw.rect(screen,(col[0]//3,col[1]//3,col[2]//3),r)
        pygame.draw.rect(screen,col,r,3)
        cx,cy=r.centerx,r.centery
        pygame.draw.circle(screen,col,(cx,cy),r.w//2-4)
        pygame.draw.circle(screen,WHITE,(cx,cy),r.w//2-4,1)
        if btn["active"]:
            pygame.draw.line(screen,BLACK,(cx-5,cy),(cx-1,cy+5),3)
            pygame.draw.line(screen,BLACK,(cx-1,cy+5),(cx+6,cy-5),3)
        else:
            lb=render_text(font_small,"!",WHITE)
            screen.blit(lb,(cx-lb.get_width()//2,cy-lb.get_height()//2))

