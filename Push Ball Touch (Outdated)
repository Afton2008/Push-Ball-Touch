SAVE_FILE     = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pushball_save.json")
DEFAULT_SLOTS = 4

def load_all_slots():
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        raw = data.get("slots", [])
        slots = []
        for e in raw:
            if e:
                slots.append({"level": int(e.get("level", 0)), "unlocked": int(e.get("unlocked", 0))})
            else:
                slots.append(None)
        if not slots:
            slots = [None] * DEFAULT_SLOTS
        return slots
    except Exception:
        return [None] * DEFAULT_SLOTS

def write_all_slots(slots):
    try:
        with open(SAVE_FILE, "w", encoding="utf-8") as f:
            json.dump({"slots": slots}, f)
    except Exception:
        pass

def save_slot(slot_idx, level, unlocked):
    if slot_idx is None:
        return
    slots = load_all_slots()
    while slot_idx >= len(slots):
        slots.append(None)
    prev = slots[slot_idx]
    best_unlocked = max(unlocked, prev["unlocked"] if prev else 0)
    slots[slot_idx] = {"level": level, "unlocked": best_unlocked}
    write_all_slots(slots)

def reset_slot(slot_idx):
    slots = load_all_slots()
    if 0 <= slot_idx < len(slots):
        slots[slot_idx] = None
        write_all_slots(slots)

def add_slot():
    slots = load_all_slots()
    slots.append(None)
    write_all_slots(slots)
    return len(slots) - 1

def remove_slot(slot_idx):
    slots = load_all_slots()
    if len(slots) <= 1:
        return
    if 0 <= slot_idx < len(slots):
        del slots[slot_idx]
        write_all_slots(slots)


