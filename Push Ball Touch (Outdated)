def event_xy(event):
    if event.type in (pygame.FINGERDOWN,pygame.FINGERMOTION,pygame.FINGERUP):
        return (event.x*WIDTH, event.y*HEIGHT)
    return event.pos

def slot_hit_test(pos):
    if SLOT_BACK_RECT.collidepoint(pos):
        return ("back",None)
    if ADD_SLOT_RECT.collidepoint(pos):
        return ("add",None)
    for i,save in enumerate(_slots):
        panel=slot_row_panel(i,slot_scroll)
        if panel.bottom<SLOT_VIEW_TOP or panel.top>SLOT_VIEW_BOT:
            continue
        main_btn,side_btn=slot_row_widgets(panel,bool(save))
        if save and side_btn.collidepoint(pos):
            return ("reset",i)
        if (not save) and len(_slots)>1 and side_btn.collidepoint(pos):
            return ("remove",i)
        if main_btn.collidepoint(pos):
            return ("main",i)
    return (None,None)

tick=0; running=True

while running:
    tick+=1

    for event in pygame.event.get():
        if event.type==pygame.QUIT: running=False

        if GAME_STATE=="MENU":
            if event.type==pygame.KEYDOWN and event.key==pygame.K_ESCAPE: running=False
            if event.type==pygame.MOUSEBUTTONDOWN:
                if MENU_PLAY_RECT.collidepoint(event.pos):
                    _slots=load_all_slots(); slot_scroll=0; GAME_STATE="SLOT"
                elif MENU_TUT_RECT.collidepoint(event.pos):
                    GAME_STATE="TUTORIAL"

        elif GAME_STATE=="SLOT":
            if event.type==pygame.KEYDOWN and event.key==pygame.K_ESCAPE: GAME_STATE="MENU"

            if event.type==pygame.MOUSEWHEEL:
                max_s=slot_max_scroll(len(_slots))
                slot_scroll=clamp(slot_scroll-event.y*44,0,max_s)

            if event.type==pygame.MOUSEBUTTONDOWN:
                if event.button==4:
                    max_s=slot_max_scroll(len(_slots)); slot_scroll=clamp(slot_scroll-44,0,max_s)
                elif event.button==5:
                    max_s=slot_max_scroll(len(_slots)); slot_scroll=clamp(slot_scroll+44,0,max_s)
                else:
                    pos=event_xy(event)
                    slot_drag_active=True; slot_drag_start_pos=pos
                    slot_drag_scroll_start=slot_scroll; slot_drag_moved=False

            if event.type==pygame.MOUSEMOTION and slot_drag_active:
                pos=event_xy(event)
                dy=slot_drag_start_pos[1]-pos[1]
                if abs(dy)>8:
                    slot_drag_moved=True
                    max_s=slot_max_scroll(len(_slots))
                    slot_scroll=clamp(slot_drag_scroll_start+dy,0,max_s)

            if event.type==pygame.MOUSEBUTTONUP:
                if slot_drag_active and not slot_drag_moved:
                    pos=event_xy(event)
                    kind,i=slot_hit_test(pos)
                    if kind=="back":
                        GAME_STATE="MENU"
                    elif kind=="add":
                        add_slot(); _slots=load_all_slots()
                        max_s=slot_max_scroll(len(_slots)); slot_scroll=max_s
                    elif kind=="reset":
                        reset_slot(i); _slots=load_all_slots()
                    elif kind=="remove":
                        remove_slot(i); _slots=load_all_slots()
                        max_s=slot_max_scroll(len(_slots)); slot_scroll=clamp(slot_scroll,0,max_s)
                    elif kind=="main":
                        save=_slots[i]; active_slot=i
                        if save:
                            lvl=clamp(save["level"],0,len(LEVELS)-1)
                            current_level=lvl; load_level(current_level)
                        else:
                            current_level=0; load_level(0)
                            save_slot(active_slot,0,0)
                        GAME_STATE="PLAYING"
                slot_drag_active=False; slot_drag_moved=False

        elif GAME_STATE=="TUTORIAL":
            if event.type==pygame.KEYDOWN and event.key==pygame.K_ESCAPE: GAME_STATE="MENU"
            if event.type==pygame.MOUSEBUTTONDOWN and TUT_BACK_RECT.collidepoint(event.pos):
                GAME_STATE="MENU"

        elif GAME_STATE=="PLAYING":
            if event.type==pygame.KEYDOWN:
                if event.key==pygame.K_ESCAPE: GAME_STATE="MENU"
                if BOSS is not None and BOSS["phase"] in ("intro","end") and event.key in (pygame.K_RETURN,pygame.K_SPACE):
                    boss_advance_click()
                    if BOSS["phase"]=="end" and BOSS["end_i"]>=len(BOSS["lines"]):
                        GAME_STATE="MENU"
                elif win and BOSS is None and event.key in(pygame.K_RETURN,pygame.K_SPACE):
                    if current_level<len(LEVELS)-1:
                        current_level+=1; load_level(current_level)
                        save_slot(active_slot,current_level,current_level)
            if event.type==pygame.MOUSEBUTTONDOWN:
                if BOSS is not None and BOSS["phase"] in ("intro","end"):
                    boss_advance_click()
                    if BOSS["phase"]=="end" and BOSS["end_i"]>=len(BOSS["lines"]):
                        GAME_STATE="MENU"
                elif win and BOSS is None:
                    if current_level<len(LEVELS)-1:
                        current_level+=1; load_level(current_level)
                        save_slot(active_slot,current_level,current_level)
                elif not win:
                    joystick_active=True; joystick_origin=event.pos; joystick_dx=joystick_dy=0.0
            if event.type==pygame.MOUSEBUTTONUP:
                joystick_active=False; joystick_dx=joystick_dy=0.0
            if event.type==pygame.MOUSEMOTION and joystick_active:
                ox,oy=joystick_origin
                dx=event.pos[0]-ox; dy=event.pos[1]-oy
                dist=math.sqrt(dx*dx+dy*dy)
                if dist>JOYSTICK_BASE_R: joystick_dx=dx/dist; joystick_dy=dy/dist
                else: joystick_dx=dx/JOYSTICK_BASE_R; joystick_dy=dy/JOYSTICK_BASE_R

    if GAME_STATE=="MENU":
        draw_menu(tick); pygame.display.flip(); clock.tick(60); continue
    if GAME_STATE=="SLOT":
        draw_slot_menu(_slots, slot_scroll); pygame.display.flip(); clock.tick(60); continue
    if GAME_STATE=="TUTORIAL":
        draw_tutorial(); pygame.display.flip(); clock.tick(60); continue

    screen.fill(BLACK)
    draw_grid()
    d=CUR

    boss_frozen = boss_tick(tick) if BOSS is not None else False

    if not boss_frozen:
        update_portals(d)

    if not win and not boss_frozen:

        keys=pygame.key.get_pressed()
        kb_dx=kb_dy=0
        if keys[pygame.K_LEFT]  or keys[pygame.K_a]: kb_dx-=1
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]: kb_dx+=1
        if keys[pygame.K_UP]    or keys[pygame.K_w]: kb_dy-=1
        if keys[pygame.K_DOWN]  or keys[pygame.K_s]: kb_dy+=1
        if kb_dx and kb_dy: kb_dx*=0.707; kb_dy*=0.707

        player_vel[0]*=0.75; player_vel[1]*=0.75
        mx=(joystick_dx if joystick_active else kb_dx)*PLAYER_SPEED+player_vel[0]
        my=(joystick_dy if joystick_active else kb_dy)*PLAYER_SPEED+player_vel[1]

        old_px,old_py=player.x,player.y
        player.x+=int(mx); player.y+=int(my)
        player.x=clamp(player.x,ARENA.x+2,ARENA.x+ARENA.w-PLAYER_SIZE-2)
        player.y=clamp(player.y,ARENA.y+2,ARENA.y+ARENA.h-PLAYER_SIZE-2)

        for w in d["walls"]:
            if player.colliderect(w):
                player.x,player.y=old_px,old_py
                player.x+=int(mx); player.x=clamp(player.x,ARENA.x+2,ARENA.x+ARENA.w-PLAYER_SIZE-2)
                if player.colliderect(w): player.x=old_px
                player.y+=int(my); player.y=clamp(player.y,ARENA.y+2,ARENA.y+ARENA.h-PLAYER_SIZE-2)
                if player.colliderect(w): player.y=old_py
                player_vel[0]=0; player_vel[1]=0

        for gr in get_closed_gate_rects(d):
            if player.colliderect(gr):
                player.x,player.y=old_px,old_py
                player.x+=int(mx); player.x=clamp(player.x,ARENA.x+2,ARENA.x+ARENA.w-PLAYER_SIZE-2)
                if player.colliderect(gr): player.x=old_px
                player.y+=int(my); player.y=clamp(player.y,ARENA.y+2,ARENA.y+ARENA.h-PLAYER_SIZE-2)
                if player.colliderect(gr): player.y=old_py
                player_vel[0]=0; player_vel[1]=0

        dpx=player.x-old_px; dpy=player.y-old_py

        for wind in d["winds"]:
            ball_vel[0]+=wind["dx"]*wind["strength"]
            ball_vel[1]+=wind["dy"]*wind["strength"]

        if rect_circle_collide(player.x,player.y,PLAYER_SIZE,PLAYER_SIZE,ball_pos[0],ball_pos[1],BALL_RADIUS):
            nx,ny,overlap=resolve_rect_circle(player.x,player.y,PLAYER_SIZE,PLAYER_SIZE,ball_pos[0],ball_pos[1],BALL_RADIUS)
            ball_pos[0]+=nx*(overlap+1); ball_pos[1]+=ny*(overlap+1)
            push=math.sqrt(dpx*dpx+dpy*dpy)
            ball_vel[0]=nx*(push*2.8+3.0); ball_vel[1]=ny*(push*2.8+3.0)

        _closed_gates = get_closed_gate_rects(d)
        _blockers = d["walls"] + _closed_gates
        resolve_ball_against_blockers(ball_pos, ball_vel, _blockers)

        ball_vel[0]*=d["friction"]; ball_vel[1]*=d["friction"]
        _dist  = math.hypot(ball_vel[0], ball_vel[1])
        _steps = min(60, max(1, int(_dist // 4) + 1))
        _sx, _sy = ball_vel[0]/_steps, ball_vel[1]/_steps
        for _step_i in range(_steps):
            ball_pos[0]+=_sx; ball_pos[1]+=_sy
            resolve_ball_against_blockers(ball_pos, ball_vel, _blockers)

        for mz in d["magnet_zones"]:
            r=mz["rect"]
            if r.collidepoint(ball_pos[0],ball_pos[1]):
                cx_m=r.x+r.w/2; cy_m=r.y+r.h/2
                ddx=cx_m-ball_pos[0]; ddy=cy_m-ball_pos[1]
                dist2=math.sqrt(ddx*ddx+ddy*ddy) or 1
                ball_vel[0]+=(ddx/dist2)*mz["force"]*0.4
                ball_vel[1]+=(ddy/dist2)*mz["force"]*0.4

        for k in d["keys"]:
            if k["collected"]: continue
            kr=k["rect"]

            for mz in d["magnet_zones"]:
                r=mz["rect"]
                if r.collidepoint(kr.centerx,kr.centery):
                    cx_m=r.x+r.w/2; cy_m=r.y+r.h/2
                    ddx=cx_m-kr.centerx; ddy=cy_m-kr.centery
                    dist2=math.sqrt(ddx*ddx+ddy*ddy) or 1

                    k.setdefault("vx",0.0); k.setdefault("vy",0.0)
                    k["vx"]+=(ddx/dist2)*mz["force"]*0.15
                    k["vy"]+=(ddy/dist2)*mz["force"]*0.15

            for wind in d["winds"]:
                k.setdefault("vx",0.0); k.setdefault("vy",0.0)
                k["vx"]+=wind["dx"]*wind["strength"]*0.4
                k["vy"]+=wind["dy"]*wind["strength"]*0.4

            if "vx" in k:
                k["vx"]*=0.85; k["vy"]*=0.85
                _kclosed_gates = get_closed_gate_rects(d)
                _kbounce = 0.45
                _ksteps = min(20, max(1, int(math.hypot(k["vx"], k["vy"]) // 4) + 1))
                for _ in range(_ksteps):
                    _ksx, _ksy = k["vx"]/_ksteps, k["vy"]/_ksteps
                    old_kx = kr.x
                    kr.x = clamp(int(kr.x+_ksx),ARENA.x+4,ARENA.x+ARENA.w-kr.w-4)
                    if any(kr.colliderect(w) for w in d["walls"]) or any(kr.colliderect(g) for g in _kclosed_gates):
                        kr.x = old_kx
                        k["vx"] = -k["vx"]*_kbounce
                    old_ky = kr.y
                    kr.y = clamp(int(kr.y+_ksy),ARENA.y+4,ARENA.y+ARENA.h-kr.h-4)
                    if any(kr.colliderect(w) for w in d["walls"]) or any(kr.colliderect(g) for g in _kclosed_gates):
                        kr.y = old_ky
                        k["vy"] = -k["vy"]*_kbounce

        _portal_eps_k = get_all_portal_endpoints(d)
        for k in d["keys"]:
            if k["collected"]: continue
            cd=k.get("portal_cd",0)
            if cd>0:
                k["portal_cd"]=cd-1
                continue
            kr=k["rect"]
            for i,ep in enumerate(_portal_eps_k):
                if ep.colliderect(kr):
                    others=[e for j,e in enumerate(_portal_eps_k) if j!=i]
                    if others:
                        target=random.choice(others)
                        kr.centerx=target.centerx; kr.centery=target.centery
                        kr.x=clamp(kr.x,ARENA.x+4,ARENA.x+ARENA.w-kr.w-4)
                        kr.y=clamp(kr.y,ARENA.y+4,ARENA.y+ARENA.h-kr.h-4)
                        k["portal_cd"]=40
                    break

        if carrying_key:
            for mz in d["magnet_zones"]:
                r=mz["rect"]
                pcx=player.x+PLAYER_SIZE/2; pcy=player.y+PLAYER_SIZE/2
                if r.collidepoint(pcx,pcy):
                    cx_m=r.x+r.w/2; cy_m=r.y+r.h/2
                    ddx=cx_m-pcx; ddy=cy_m-pcy
                    dist2=math.sqrt(ddx*ddx+ddy*ddy) or 1

                    player_vel[0]+=(ddx/dist2)*mz["force"]*0.18
                    player_vel[1]+=(ddy/dist2)*mz["force"]*0.18
            for wind in d["winds"]:
                player_vel[0]+=wind["dx"]*wind["strength"]*3.5
                player_vel[1]+=wind["dy"]*wind["strength"]*3.5

        if ball_pos[0]-BALL_RADIUS<ARENA.x+2:
            ball_pos[0]=ARENA.x+2+BALL_RADIUS; ball_vel[0]=abs(ball_vel[0])*BOUNCE
        if ball_pos[0]+BALL_RADIUS>ARENA.x+ARENA.w-2:
            ball_pos[0]=ARENA.x+ARENA.w-2-BALL_RADIUS; ball_vel[0]=-abs(ball_vel[0])*BOUNCE
        if ball_pos[1]-BALL_RADIUS<ARENA.y+2:
            ball_pos[1]=ARENA.y+2+BALL_RADIUS; ball_vel[1]=abs(ball_vel[1])*BOUNCE
        if ball_pos[1]+BALL_RADIUS>ARENA.y+ARENA.h-2:
            ball_pos[1]=ARENA.y+ARENA.h-2-BALL_RADIUS; ball_vel[1]=-abs(ball_vel[1])*BOUNCE

        for h in d["holes"]:
            if h.collidepoint(ball_pos[0],ball_pos[1]):
                ball_pos=list(d["ball_start"]); ball_vel=[0.0,0.0]; break

        for k in d["keys"]:
            if k["collected"]:
                continue
            kr = k["rect"]
            for h in d["holes"]:
                if h.colliderect(kr):
                    kr.x = k["start_x"]; kr.y = k["start_y"]
                    k["vx"] = 0.0; k["vy"] = 0.0; k["portal_cd"] = 0
                    break

        if carrying_key:
            for h in d["holes"]:
                if h.colliderect(player):

                    if current_key_obj is not None:
                        current_key_obj["collected"] = False
                        current_key_obj["rect"].x = current_key_obj["start_x"]
                        current_key_obj["rect"].y = current_key_obj["start_y"]
                        current_key_obj["vx"] = 0.0
                        current_key_obj["vy"] = 0.0
                        current_key_obj["portal_cd"] = 0
                    carrying_key    = False
                    current_key_obj = None
                    break

        for btn in d["buttons"]:
            if not btn["active"]:
                br=btn["rect"]
                if rect_circle_collide(br.x,br.y,br.w,br.h,ball_pos[0],ball_pos[1],BALL_RADIUS):
                    btn["active"]=True
                    gi=btn["gate_index"]
                    if gi<len(d["gates"]):
                        d["gates"][gi]["open"]=True
                        gates_opened+=1
                    nx,ny,overlap=resolve_rect_circle(br.x,br.y,br.w,br.h,ball_pos[0],ball_pos[1],BALL_RADIUS)
                    ball_pos[0]+=nx*(overlap+1); ball_pos[1]+=ny*(overlap+1)
                    dot=ball_vel[0]*nx+ball_vel[1]*ny
                    ball_vel[0]=(ball_vel[0]-2*dot*nx)*BOUNCE
                    ball_vel[1]=(ball_vel[1]-2*dot*ny)*BOUNCE
                    eval_can_finish(d)

        _portal_eps = get_all_portal_endpoints(d)

        if ball_portal_cd>0:
            ball_portal_cd-=1
        else:
            for i,ep in enumerate(_portal_eps):
                if ep.collidepoint(ball_pos[0],ball_pos[1]):
                    others=[e for j,e in enumerate(_portal_eps) if j!=i]
                    if others:
                        target=random.choice(others)
                        ball_pos[0]=target.centerx; ball_pos[1]=target.centery
                        ball_portal_cd=60
                    break

        if player_portal_cd>0:
            player_portal_cd-=1
        else:
            pcx,pcy=player.centerx,player.centery
            for i,ep in enumerate(_portal_eps):
                if ep.collidepoint(pcx,pcy):
                    others=[e for j,e in enumerate(_portal_eps) if j!=i]
                    if others:
                        target=random.choice(others)
                        player.centerx=target.centerx; player.centery=target.centery
                        player.x=clamp(player.x,ARENA.x+2,ARENA.x+ARENA.w-PLAYER_SIZE-2)
                        player.y=clamp(player.y,ARENA.y+2,ARENA.y+ARENA.h-PLAYER_SIZE-2)
                        player_portal_cd=60
                    break

        if not carrying_key:
            for k in d["keys"]:
                if not k["collected"] and player.colliderect(k["rect"]):
                    k["collected"] = True
                    carrying_key    = True
                    current_key_obj = k

                    break

        if carrying_key and player.colliderect(goal):
            carrying_key    = False
            current_key_obj = None
            keys_delivered += 1
            eval_can_finish(d)

        if can_finish:
            if (goal.x+6<ball_pos[0]<goal.x+GOAL_W-6 and
                    goal.y+6<ball_pos[1]<goal.y+GOAL_H-6):
                if not win:
                    win=True
                    if current_level>=len(LEVELS)-1:
                        save_slot(active_slot,current_level,current_level)
                    if BOSS is not None and BOSS["phase"]=="wait":
                        BOSS["phase"]="kill"; BOSS["kill_timer"]=0

    draw_arena()
    for w in d["winds"]: update_draw_wind(w)
    flush_wind_particles()
    draw_magnet_zones(d["magnet_zones"],tick)
    draw_holes(d["holes"],tick)
    draw_portals(d["portals"],tick)
    draw_walls(d["walls"])
    draw_gates_and_buttons(d,tick)
    draw_keys(d,tick)
    draw_goal_obj(goal,d,tick)
    draw_ball()
    if not (BOSS is not None and BOSS["phase"] in ("kill","end") and (BOSS["phase"]=="end" or BOSS.get("kill_timer",0)>=BOSS_KILL_TICKS//2)):
        draw_player(tick)
    draw_joystick()
    draw_hud(d,tick)
    if BOSS is not None:
        draw_boss(tick)
        draw_boss_dialogue()
    if win and BOSS is None:
        draw_win_screen()
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()